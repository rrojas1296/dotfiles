{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2
    },
    "color": {
        "1": "36",
        "2": "37",
    }
  },
  "display": {
    "separator": " ",
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "32",
        "host": "34"
      }
    },

    {
      "type": "separator",
      "symbol": "-",
    },
    {
      "type": "os",
      "key": "󰣇 OS ",
      "format": "{name} {arch}",
      "keyColor": "31"
    },
    {
      "type": "kernel",
      "key": " KER",
      "keyColor": "32"
    },
    {
      "type": "packages",
      "key": " PKG",
      "keyColor": "33",
      "format": "{all} (pacman)"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "34"
    },
    {
      "type": "gpu",
      "key": " GPU",
      "keyColor": "35",
      "hideType": "integrated",
    },
    {
      "type": "shell",
      "key": " SHE",
      "keyColor": "36"
    },
    {
      "type": "terminal",
      "key": " TER",
      "keyColor": "37"
    },
    {
      "type": "uptime",
      "key": " UP ",
      "keyColor": "38"
    },
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
