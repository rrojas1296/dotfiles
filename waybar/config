{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 10,
  "margin-left": 20,
  "margin-right": 20,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "custom/updates",
    "custom/lang",
    "custom/volume",
    "memory"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
    },
    "format-icons": {
      "1": " ",
      "2": " ",
      "3": " ",
      "4": " ",
      "5": "󰓇 ",
      "6": " ",
      "7": " ",
      "default": ""
    },
    "sort-by-number": true
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50
  },
  "custom/lang": {
    "exec": "layout.sh",
    "interval": 1,
    "return-type": "json",
    "on-click": "layout.sh --toggle"
  },
  "custom/launcher": {
    "interval": 1,
    "format": "󰐥 ",
    "on-click": "powermenu.sh"
  },
  "custom/updates": {
    "exec": "updates.sh --checkUpdates",
    "interval": 10,
    "return-type": "json",
    "on-click": "updates.sh --update"
  },
  "network": {
    "interface": "enp5s0",
    "format-ethernet": "{bandwidthUpBits} 󰕒 {bandwidthDownBits} 󰇚",
    "format-disconnected": "No connection", //An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50
  },
  "clock": {
    "format": "{:%A %d, %I:%M %p}",
    "interval": 60,
    "tooltip": true,
    "tooltip-format": "{:%Y-%m-%d}"
  },
  "pulseaudio": {
    "format": " {volume}%",
    "on-click": "eww open volume",
    "on-click-right": "eww close volume_popup"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true
  },
  "tray": {
    "spacing": 8
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 14,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "sort-by-app-id": true
  },
  "hyprland/window": {
    "format": "{initialTitle}",
    "separate-outputs": true
  },
  "memory": {
    "format": "  {percentage}%",
    "interval": 1
  },
  "custom/volume": {
    "exec": "pamixer --get-volume",
    "format": "  {}%",
    "interval": 1,
    "on-click": "eww open volume",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5"
  }
}
